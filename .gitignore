# Secrets (NEVER version)
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
CLAUDE.md
briefing_claude_desktop.md

# Smoke test and generation pilot outputs (disposable: they only test the
# pipeline and measure time). The REAL generations (results/generations/<phase>/)
# MUST be versioned, as they are the raw evidence.
results/generations/_smoke_test/
results/generations/_pilot/
results/pilot/geracoes/_smoke_test/
results/pilot/geracoes/_piloto/

# Leftovers of an interrupted run (lock and half-written files).
results/**/_running.lock
results/**/_rodando.lock
results/**/*.tmp

# Papers in PDF and thesis text (third-party material, with copyright).
#   Zhang et al. (2024): https://doi.org/10.1145/3691620.3695290
artigo/

# Zhang et al. (2024) dataset: 5.5 MB of code from ~51 third-party
# repositories, most without an explicit license. Do not redistribute;
# download it from Zenodo, the citable and permanent source:
#   https://doi.org/10.5281/zenodo.13335000
# Unzip it into data/dataset_zhang/ (see pysmell/README.md).
data/dataset_zhang/

# PyExamine corpus (third-party code, Zenodo 10.5281/zenodo.14066039): only
# the .py files, rebuilt with python -m data.pyexamine.extract_py.
data/dataset_pyexamine/

# Windows/OneDrive junk
desktop.ini
Thumbs.db
